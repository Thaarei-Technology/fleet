{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DOKPLOY_URL",
    "DOKPLOY_API_KEY",
    "DOKPLOY_ENVIRONMENT",
    "APPROVAL_EVIDENCE_ID",
    "INITIATING_ACTOR",
    "APPROVING_ACTOR",
    "ROLLBACK_SCHEMA_COMPATIBLE",
    "ROLLBACK_ATTESTATION_VERIFIED",
    "GITHUB_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!**/.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
