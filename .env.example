APP_ENV=local
NODE_ENV=development
THAAREI_FLEET_FIXTURE_ID=local
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_PROXY_CIDRS=
REQUEST_BODY_LIMIT_BYTES=1048576
RESPONSE_BODY_LIMIT_BYTES=2097152
REQUEST_TIMEOUT_MS=15000
DATABASE_ADMIN_URL=postgres://starter_admin:starter_admin_local@127.0.0.1:5432/starter
DATABASE_CREDENTIALS_FILE=.artifacts/database-credentials.env
API_DATABASE_URL=postgres://starter_api:starter_api_local@127.0.0.1:5432/starter
WORKER_DATABASE_URL=postgres://starter_worker:starter_worker_local@127.0.0.1:5432/starter
MIGRATOR_DATABASE_URL=postgres://starter_migrator:starter_migrator_local@127.0.0.1:5432/starter
BETTER_AUTH_SECRET=replace-with-a-local-secret
BETTER_AUTH_URL=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:3001
WORKER_PORT=3002
WORKER_CONCURRENCY=2
IDENTITY_MAIL_PROVIDER=mailpit
IDENTITY_FROM_EMAIL=identity@example.test
IDENTITY_ZEPTOMAIL_API_KEY=
